# ============================================================
# CMRIT Canteen — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# --- Supabase (MANDATORY) ---
# Found in Supabase Project Settings > API
# Ensure you do not include trailing slashes in the URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Staff Access (MANDATORY) ---
# A 4-digit PIN used to access the staff dashboard and reset stock
STAFF_PIN=1234

# --- Razorpay Payment Gateway (OPTIONAL / DEPRECATED) ---
# Currently the system uses a pure credit-based wallet.
# Configure these only if local credit processing is bypassed.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- App Settings ---
# Revalidation time for the menu (in seconds)
NEXT_PUBLIC_MENU_REVALIDATE=60

# ============================================================
# --- Push Notifications Service ---
# ============================================================
# --- ntfy.sh Push Notifications ---
# The unique pub-sub topic the canteen guy subscribes to in order to get order alarms
NTFY_TOPIC=your-unique-ntfy-topic-here
