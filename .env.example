# ============================================================
# CMRIT Canteen — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# --- Supabase (MANDATORY) ---
# Found in Supabase Project Settings > API
# Ensure you do not include trailing slashes in the URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Staff Access (MANDATORY) ---
# SECURITY: Use a long, random string (e.g. generate with: openssl rand -hex 16)
# A short 4-digit PIN is brute-forceable in under 2 minutes — do NOT use one in production.
STAFF_PIN=use-a-long-random-string-here


# --- App Settings ---
# Revalidation time for the menu (in seconds)
NEXT_PUBLIC_MENU_REVALIDATE=60

# ============================================================
# --- Push Notifications Service ---
# ============================================================
# --- ntfy.sh Push Notifications ---
# The unique pub-sub topic the canteen guy subscribes to in order to get order alarms
NTFY_TOPIC=your-unique-ntfy-topic-here
