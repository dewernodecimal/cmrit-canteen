# ============================================================
# CMRIT Canteen — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# --- Supabase (MANDATORY) ---
# Found in Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Staff Access (MANDATORY) ---
# A 4-digit PIN used to access the staff dashboard and reset stock
STAFF_PIN=6626

# --- Razorpay (OPTIONAL / DEPRECATED) ---
# Currently the system uses a pure credit-based wallet
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- App Settings ---
# Revalidation time for the menu (in seconds)
NEXT_PUBLIC_MENU_REVALIDATE=60
